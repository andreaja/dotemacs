# Package state, redirected here by no-littering (see init/loadenv.el). Anything
# a package persists lands under var/, so new packages should not need new
# entries. Its sibling etc/ holds config worth tracking and is deliberately absent.
/var/

# Editor and OS junk
*~
*.elc
\.#.*
.DS_Store

.latest-build
/jslint-reporter/
.claude/settings.local.json
